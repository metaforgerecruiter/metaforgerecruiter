# ==============================================================================
# Resume Parser Module - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Note: GEMINI_API_KEY is optional. If omitted, the module operates in
# local deterministic fallback mode with zero external cloud dependencies.
# ==============================================================================

# Gemini AI API Key (Optional)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini Model for resume extraction
GEMINI_MODEL=gemini-2.5-flash-lite

# Comma-separated list of fallback Gemini models used on rate limits or 503
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Standalone Server Configuration (Optional, only needed if running server.ts)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*
