# Copy to .env and fill values. Never commit secrets.

# --- Frontend ---
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_URL=http://localhost:3001

# --- Backend ---
PORT=3001
NODE_ENV=development
# Swagger UI at /api/docs. Defaults on when NODE_ENV is not production. Set false to disable.
SWAGGER_ENABLED=
MONGODB_URI=mongodb://localhost:27017/metaforge_recruiter_v2
MONGODB_DB_NAME=metaforge_recruiter_v2
REDIS_URL=redis://localhost:6379
# Required (env/vault only). Min 32 chars. Never commit real secrets.
# Example generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Local: http://localhost:3000. Production: https://your-domain (HTTPS only).
CORS_ORIGINS=http://localhost:3000
# Transport: HTTPS everywhere in production. Set FORCE_HTTPS=true to enforce in staging.
FORCE_HTTPS=
TRUST_PROXY=
COOKIE_SECURE=
# Private resume/files store — MUST be outside web root (not under frontend/public).
# Docker: /data/storage. Local (from backend/): ./storage/private
STORAGE_ROOT=./storage/private
# Optional dedicated HMAC key for download links (defaults to JWT_SECRET). Min 32 chars.
FILE_SIGNING_SECRET=
# Signed download link lifetime (seconds), default 300, max 3600.
FILE_DOWNLOAD_TTL_SECONDS=300
# Demo users: forbidden in production. Local only with ALLOW_DEMO_LOGIN=true + SEED_DEMO_PASSWORD.
SEED_ON_START=false
ALLOW_DEMO_LOGIN=false
SEED_DEMO_PASSWORD=
# Optional per-role overrides: DEMO_PASSWORD_SUPERADMIN, DEMO_PASSWORD_ADMIN, DEMO_PASSWORD_LEAD, etc.
RATE_LIMIT_PER_MINUTE=120
# Optional webhook for security alerts (failed logins, privilege changes, bulk exports). Payload is redacted.
SECURITY_ALERT_WEBHOOK_URL=

# --- Frontend (local demo chooser only; never in production builds) ---
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
NEXT_PUBLIC_DEMO_PASSWORD=

# --- Auto mail extraction (Microsoft 365 -> Requirements) ---
# Shared secret the Python pipeline uses to call POST /api/v1/requirements/ingest-email
INTERNAL_AUTOMATION_API_KEY=
MAIL_EXTRACTION_SCHEDULE_ENABLED=true
MAIL_EXTRACTION_INTERVAL_MINUTES=2
MAIL_EXTRACTION_INITIAL_BACKFILL=true
MAIL_EXTRACTION_HISTORICAL_DAYS=2
MAIL_EXTRACTION_HISTORICAL_LIMIT=200
MAIL_EXTRACTION_TIMEZONE=Asia/Kolkata
MAIL_EXTRACTION_TIMEOUT_MINUTES=20
# Optional overrides; by default "Mail extraction/devloper/devloper" and its .venv are used
MAIL_EXTRACTION_DIR=
MAIL_EXTRACTION_PYTHON=
MAIL_EXTRACTION_BACKEND_URL=

# --- AI Gateway ---
AI_GATEWAY_URL=http://localhost:3002
AI_GATEWAY_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional integrations (leave empty until approved) ---
PDL_API_KEY=
NAUKRI_API_KEY=
RESEND_API_KEY=
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
