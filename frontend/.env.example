# Local (HTTP). Production: prefer same-origin /api/v1 over HTTPS only.
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_URL=http://localhost:3001

# Transport: set in production/staging (HTTPS redirect + HSTS). Default on when NODE_ENV=production.
FORCE_HTTPS=

# Role quick-chooser on sign-in (local/dev only; always off in production builds).
# Default: shown in development. Set to false to hide.
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=
# Optional override for all demo passwords (otherwise local seed defaults are used).
NEXT_PUBLIC_DEMO_PASSWORD=
